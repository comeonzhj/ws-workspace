    "mcp": "node mcp-server.js"
  },
  "keywords": [
    "workspace",
    "dashboard",
    "websocket",
    "kanban",
    "todo",
    "real-time",
    "cli",
    "agent",
    "collaboration"
  ],
  "author": {
