    "url": "https://github.com/comeonzhj"
  },
  "license": "MIT",
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/comeonzhj/ws-workspace.git"
  },
  "bugs": {
    "url": "https://github.com/comeonzhj/ws-workspace/issues"
  },
  "homepage": "https://github.com/comeonzhj/ws-workspace#readme",
  "files": [
    "bin/",
    "server.js",
    "ws-cli.js",
    "mcp-server.js",
    "skills/",
    "public/",
    "README.md",
    "README.zh-CN.md"
  ],
  "engines": {
